# Copy to .env and fill in.

# PostgreSQL with the pgvector extension installed (CREATE EXTENSION vector is run automatically).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tambaya

# Groq (answer generation + query rewriting). Get a key at https://console.groq.com/keys
# Leave empty to run in offline mode: answers are the verified entries verbatim; /api/health reports the mode.
GROQ_API_KEY=
# Production models on Groq as of Oct 2026 (llama-3.3-70b-versatile was retired for free/dev tiers on 16 Aug 2026).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# low | medium | high (gpt-oss models only; low keeps latency down)
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_S=25

# Embeddings are computed locally (Groq has no embeddings endpoint).
EMBED_DIM=768
# Optional neural embedder (pip install sentence-transformers), e.g. intfloat/multilingual-e5-small with EMBED_DIM=384,
# then run: python -m scripts.init_db --reembed
LOCAL_EMBED_MODEL=

# Protects /api/admin/* (sent as X-Admin-Token header).
ADMIN_TOKEN=change-me

# Optional: Firecrawl for refreshing official pages into staged (pending-review) knowledge entries.
FIRECRAWL_API_KEY=

# Comma-separated origins allowed to call the API (frontend is served by the API itself by default).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Retrieval tuning
RETRIEVAL_TOP_K=5
